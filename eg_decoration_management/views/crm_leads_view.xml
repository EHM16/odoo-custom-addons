<odoo>
    <record id="crm_lead_form_inherit_decoration_order" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.decoration.order</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_decoration_order" type="object" string="Create Decoration Order"
                        class="btn-primary" invisible="not view_decoration_order_button"/>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Decoration Order">
                    <group>
                        <group string="Address Details">
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="decoration_street" placeholder="Street..." class="o_address_street"/>
                                <field name="decoration_street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="decoration_city" placeholder="City" class="o_address_city"/>
                                <field name="decoration_state_id" class="o_address_state" placeholder="State"
                                       can_write="True"
                                       can_create="True" options="{'no_open': True, 'no_quick_create': True}"
                                       context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="decoration_zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="decoration_country_id" placeholder="Country" can_create="True"
                                       can_write="True"
                                       options="{'no_open': True, 'no_create': True}" class="o_address_country"/>
                            </div>
                        </group>
                        <group string="Order Details">
                            <field name="decoration_event_type_id"/>
                            <field name="decoration_start"/>
                            <field name="decoration_end"/>
                            <field name="decoration_package_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="decoration_guest"/>
                        </group>
                    </group>

                </page>
            </xpath>
            <xpath expr="//field[@name='active']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_decoration_order" type="object" class="oe_stat_button"
                            icon="fa-magic" invisible="decoration_order_count == 0">
                        <field name="decoration_order_count" widget="statinfo" string="Decoration Orders"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="decoration_crm_lead_all_leads" model="ir.actions.act_window">
        <field name="name">Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('type','=','lead')]</field>
    </record>

    <menuitem id="decoration_crm_leads_menu" name="Lead" parent="decoration_main_menu" sequence="20"/>
    <menuitem id="decoration_crm_leads_submenu" name="Leads" parent="decoration_crm_leads_menu"
              action="decoration_crm_lead_all_leads" sequence="10"/>
    <menuitem id="crm_pipeline_submenu" name="Pipeline" parent="decoration_crm_leads_menu"
              action="crm.crm_lead_action_pipeline" sequence="20"/>
</odoo>
