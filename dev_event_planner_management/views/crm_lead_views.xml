<odoo>
    <record id="crm_lead_view_form_inherit_planner" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.planner</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_convert_to_event" type="object"
                        string="Convert to Event" class="btn-secondary"
                        invisible="planner_event_id or type != 'opportunity'"
                        groups="dev_event_planner_management.group_event_planner_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_convert_to_event" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="not planner_event_id"
                        groups="dev_event_planner_management.group_event_planner_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Event</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="planner_event_id" invisible="1"/>
            </xpath>
            <xpath expr="//group/group[@invisible=&quot;type == 'lead'&quot;]" position="inside">
                <field name="event_type_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//group/group[@invisible=&quot;type == 'opportunity'&quot; and not(@name)]" position="inside">
                <field name="event_type_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="planner_crm_lead_action" model="ir.actions.act_window">
        <field name="name">Inquiries</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'default_type': 'lead'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No inquiries found. Let's plan an event!
            </p>
        </field>
    </record>
</odoo>
