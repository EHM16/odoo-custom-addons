<odoo>
    <record id="purchase_order_view_form_inherit_planner" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.planner</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="planner_event_id" readonly="state not in ('draft', 'sent')"/>
            </field>
        </field>
    </record>
</odoo>
