<odoo>
    <record id="planner_event_guest_view_list" model="ir.ui.view">
        <field name="name">planner.event.guest.list</field>
        <field name="model">planner.event.guest</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="event_id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone" optional="hide"/>
                <field name="seats"/>
                <field name="rsvp_state" widget="badge" decoration-success="rsvp_state == 'accepted'" decoration-danger="rsvp_state == 'declined'"/>
                <field name="meal_choice_id"/>
                <field name="table_ref" optional="show"/>
                <field name="is_vip" optional="show"/>
            </list>
        </field>
    </record>

    <record id="planner_event_guest_view_search" model="ir.ui.view">
        <field name="name">planner.event.guest.search</field>
        <field name="model">planner.event.guest</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="event_id"/>
                <filter string="VIP" name="vip" domain="[('is_vip', '=', True)]"/>
                <filter string="RSVP Pending" name="pending" domain="[('rsvp_state', '=', 'pending')]"/>
                <!-- <group expand="0" string="Group By"> -->
                <filter string="Event" name="group_event" context="{'group_by': 'event_id'}"/>
                <filter string="RSVP" name="group_rsvp" context="{'group_by': 'rsvp_state'}"/>
                <filter string="Meal Choice" name="group_meal" context="{'group_by': 'meal_choice_id'}"/>
                <!-- </group> -->
            </search>
        </field>
    </record>

    <record id="planner_event_guest_action" model="ir.actions.act_window">
        <field name="name">Guests</field>
        <field name="res_model">planner.event.guest</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_event': 1}</field>
    </record>
</odoo>
