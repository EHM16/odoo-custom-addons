<odoo>
    <record id="planner_event_quote_wizard_view_form" model="ir.ui.view">
        <field name="name">planner.event.quote.wizard.form</field>
        <field name="model">planner.event.quote.wizard</field>
        <field name="arch" type="xml">
            <form string="New Quotation">
                <group>
                    <group>
                        <field name="event_id" readonly="1"/>
                        <field name="partner_id"/>
                        <field name="sale_order_template_id"/>
                    </group>
                    <group>
                        <field name="require_signature"/>
                        <field name="require_payment"/>
                        <field name="prepayment_percent" invisible="not require_payment"/>
                    </group>
                </group>
                <field name="product_ids" widget="many2many_tags"/>
                <footer>
                    <button name="action_create_quotation" type="object"
                            string="Create Quotation" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
