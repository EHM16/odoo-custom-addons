<odoo>

    <record id="view_decoration_checklist_template_list" model="ir.ui.view">
        <field name="name">decoration.checklist.template.list</field>
        <field name="model">decoration.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="decoration_checklist_item_ids"
                       widget="many2many_tags"
                       string="Checklist Items"/>
            </list>
        </field>
    </record>

    <record id="view_decoration_checklist_template_form" model="ir.ui.view">
        <field name="name">decoration.checklist.template.form</field>
        <field name="model">decoration.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <label for="name"/>
                    <h1>
                        <field name="name" required="1"/>
                    </h1>
                    <notebook>
                        <page string="Checklist Items">
                            <field name="decoration_checklist_item_ids">
                                <list editable="bottom">
                                    <control>
                                        <create string="Add a item"/>
                                        <create string="Add a section"
                                                context="{'default_display_type': 'line_section'}"/>
                                    </control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="1"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_decoration_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">decoration.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="checklist_templates_submenu" name="Checklist Templates" parent="decoration_configuration_menu"
              sequence="20" action="action_decoration_checklist_template"/>
</odoo>
