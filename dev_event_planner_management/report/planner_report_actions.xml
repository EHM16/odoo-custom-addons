<odoo>
    <record id="action_report_beo" model="ir.actions.report">
        <field name="name">Banquet Event Order (BEO)</field>
        <field name="model">planner.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dev_event_planner_management.report_beo</field>
        <field name="report_file">dev_event_planner_management.report_beo</field>
        <field name="print_report_name">'BEO v%s - %s' % (object.beo_version, object.reference)</field>
        <field name="binding_model_id" ref="model_planner_event"/>
        <field name="binding_type">report</field>
    </record>

