<odoo>
    <record id="module_category_event_planner" model="ir.module.category">
        <field name="name">Event Planner</field>
        <field name="description">Access rights for the Event Planner Management application</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_event_planner" model="res.groups.privilege">
        <field name="name">Event Planner Management</field>
        <field name="category_id" ref="module_category_event_planner"/>
    </record>

    <record id="group_event_planner_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_event_planner"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Event planners: see their own and followed events.</field>
    </record>

    <record id="group_event_planner_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_event_planner"/>
        <field name="implied_ids" eval="[(4, ref('group_event_planner_user'))]"/>
        <field name="comment">Full access to all events and configuration.</field>
    </record>
</odoo>
