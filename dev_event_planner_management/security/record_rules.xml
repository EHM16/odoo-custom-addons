<odoo>
    <record id="planner_event_rule_user" model="ir.rule">
        <field name="name">Event Planner: own or followed events</field>
        <field name="model_id" ref="model_planner_event"/>
        <field name="domain_force">['|', '|',
            ('user_id', '=', user.id),
            ('coordinator_id', '=', user.id),
            ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_event_planner_user'))]"/>
    </record>

    <record id="planner_event_rule_manager" model="ir.rule">
        <field name="name">Event Planner: manager sees all</field>
        <field name="model_id" ref="model_planner_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_event_planner_manager'))]"/>
    </record>

    <record id="planner_event_rule_company" model="ir.rule">
        <field name="name">Event Planner: multi-company</field>
        <field name="model_id" ref="model_planner_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="planner_event_rule_portal" model="ir.rule">
        <field name="name">Event Planner: portal sees shared events</field>
        <field name="model_id" ref="model_planner_event"/>
        <field name="domain_force">['|', ('message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id]), ('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

