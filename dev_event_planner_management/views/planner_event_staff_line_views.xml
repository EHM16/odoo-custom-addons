<odoo>
    <record id="planner_event_staff_line_view_list" model="ir.ui.view">
        <field name="name">planner.event.staff.line.list</field>
        <field name="model">planner.event.staff.line</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('declined', 'cancelled')" decoration-success="state == 'confirmed'">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="event_id"/>
                <field name="role"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'requested'"/>
                <button name="action_request" type="object" icon="fa-paper-plane" title="Request confirmation" invisible="state != 'draft'"/>
                <button name="action_confirm" type="object" icon="fa-check" title="Confirm" invisible="state not in ('draft', 'requested')"/>
                <button name="action_decline" type="object" icon="fa-times" title="Decline" invisible="state not in ('draft', 'requested')"/>
            </list>
        </field>
    </record>

    <record id="planner_event_staff_line_view_calendar" model="ir.ui.view">
        <field name="name">planner.event.staff.line.calendar</field>
        <field name="model">planner.event.staff.line</field>
        <field name="arch" type="xml">
            <calendar date_start="date_from" date_stop="date_to" color="employee_id" mode="week" quick_create="0">
                <field name="event_id"/>
                <field name="employee_id" filters="1"/>
                <field name="role"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="planner_event_staff_line_view_search" model="ir.ui.view">
        <field name="name">planner.event.staff.line.search</field>
        <field name="model">planner.event.staff.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="event_id"/>
                <filter string="Unconfirmed" name="unconfirmed" domain="[('state', 'in', ('draft', 'requested'))]"/>
                <filter string="Upcoming" name="upcoming" domain="[('date_from', '&gt;=', context_today())]"/>
                <!-- <group expand="0" string="Group By"> -->
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Event" name="group_event" context="{'group_by': 'event_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <!-- </group> -->
            </search>
        </field>
    </record>

    <record id="planner_event_staff_line_action" model="ir.actions.act_window">
        <field name="name">Staff Schedule</field>
        <field name="res_model">planner.event.staff.line</field>
        <field name="view_mode">calendar,list</field>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>
</odoo>
