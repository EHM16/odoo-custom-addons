#. module: delivery_split
#: model:ir.module.module,description:base.module_delivery_split
msgid ""
" In Odoo,currently delivery will be created to the customer\n"
"     of sale order. Using Delivery Split,we can split the delivery to\n"
"     different recipients added in each sale order line."
msgstr ""
"En Odoo, la entrega se crea para el cliente de la orden de venta.\n"
"     Con la división de entregas, es posible separar la entrega entre los\n"
"     distintos destinatarios indicados en cada línea de la orden de venta."

#. module: delivery_split
#: code:models/sale_order_line.py:29
msgid "Choose a recipient for splitting delivery"
msgstr "Elija un destinatario para dividir la entrega"

#. module: delivery_split
#: code:models/sale_order.py:34
msgid "Consolidate Orders"
msgstr "Consolidar órdenes"

#. module: delivery_split
#: model:ir.module.module,summary:base.module_delivery_split
msgid "Delivery can be split to different recipients"
msgstr "La entrega se puede dividir entre diferentes destinatarios."

#. module: delivery_split
#: code:models/sale_order.py:30
#: model:ir.module.module,name:base.module_delivery_split
msgid "Delivery Split"
msgstr "Entrega dividida"

#. module: delivery_split
#: code:models/sale_order.py:30
msgid "Enable the option to add recipients to each sale order line to split delivery"
msgstr "Habilite la opción para agregar destinatarios a cada línea de orden de venta para dividir la entrega"

#. module: delivery_split
#: code:models/sale_order.py:34
msgid "Enable the option to consolidate orders if choose same recipients in split delivery"
msgstr ""
"Habilita la consolidación de órdenes cuando se eligen los mismos destinatarios en una entrega dividida"

#. module: delivery_split
#: code:models/sale_order_line.py:29
msgid "Recipient"
msgstr "Destinatario"
