<odoo>
    <record id="planner_event_reschedule_wizard_view_form" model="ir.ui.view">
        <field name="name">planner.event.reschedule.wizard.form</field>
        <field name="model">planner.event.reschedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Reschedule Event">
                <div class="alert alert-info" role="alert">
                    Open checklist deadlines, run-of-show lines, staff shifts,
                    vendor arrival times and pending payment due dates will be
                    shifted. Confirmed staff will be asked to re-confirm and
                    booked vendors flagged for reconfirmation.
                </div>
                <group>
                    <field name="event_id" invisible="1"/>
                    <field name="current_date_start"/>
                    <field name="new_date_start"/>
                    <field name="new_date_end"/>
                    <field name="force"/>
                </group>
                <footer>
                    <button name="action_reschedule" type="object"
                            string="Reschedule" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
