<odoo>
    <record id="planner_event_stage_view_list" model="ir.ui.view">
        <field name="name">planner.event.stage.list</field>
        <field name="model">planner.event.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="is_booked_stage"/>
                <field name="is_locked_stage"/>
                <field name="is_closeout_stage"/>
                <field name="is_done_stage"/>
                <field name="is_cancelled_stage"/>
                <field name="mail_template_id"/>
            </list>
        </field>
    </record>

    <record id="planner_event_stage_action" model="ir.actions.act_window">
        <field name="name">Event Stages</field>
        <field name="res_model">planner.event.stage</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
